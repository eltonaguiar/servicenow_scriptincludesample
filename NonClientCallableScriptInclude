/*****************************************************************************************************************************************
SCRIPT INCLUDE (not client callable)
Given a Caller's Sys_id and Incident Sys_Id, this returns the count of other active incidents with Caller of the Incident's assigned Caller
****************************************************************************************************************************************/

var IncidentCaller = Class.create();
IncidentCaller.prototype = {

    initialize: function() {
        //this.st = new IncidentState();

    },

    openCount: function(callersysid, currentInc) {
        if (!callersysid) {
            return 0;
        }

        var gr = new GlideRecord('incident');
        gr.addQuery('caller_id', callersysid);
		gr.addQuery('active',true);

		if (currentInc)
		{
			gr.addQuery('sys_id','<>',currentInc);
		}
        
        gr.query();
		return gr.getRowCount();

    },

    type: 'IncidentCaller'
};

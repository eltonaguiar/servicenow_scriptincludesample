var IncidentAjaxUtils = Class.create();
IncidentAjaxUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    ///DO NOT INITIALIZE IN A CLIENT CALLABLE SCRIPT INCLUDE !
    /*
    	initialize:function()
    	{

    	}	,
    	*/

    getCallerOpenStats: function() {

        try {


            var gruser = new GlideRecord("sys_user");

            userid = this.getParameter('sysparm_user_id');




            if (!GlideStringUtil.isEligibleSysID(userid)) {
                return JSON.stringify({
                    ok: false,
                    error: 'invalid_user'
                });
            }


            gruser.get(userid);

            var grincidents = new GlideAggregate('incident');
            grincidents.addAggregate("COUNT");
            grincidents.addQuery("caller_id", userid);
			grincidents.addQuery("active", true);

            grincidents.query();
            var count = grincidents.next() ? grincidents.getAggregate("COUNT") : 0;



            return JSON.stringify({
                ok: true,
                count: count
            });
        } catch (err) {
            
			gs.error('error occured');
			 return JSON.stringify({
                ok: false,
                count: count,
				error:String(err)
            });
        }


    },

    type: 'IncidentAjaxUtils'
})


;

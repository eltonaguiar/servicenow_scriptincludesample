        return;
    }

    var ga = new GlideAjax("IncidentAjaxUtils_GlideQuery");

    ga.addParam("sysparm_name", "getCallerOpenStats");
    ga.addParam("sysparm_user_id", newValue);

	

    var answer = ga.getXMLAnswer(function(answer) {

        if (!answer) {
            alert('answer is not provided' + answer + ' - Script Include IncidentAjaxUtils may be disabled are not client callable ');
            return;
        }

        var data = JSON.parse(answer);
        if (!data.ok) {
            alert('data is not ok, error:' + data.error);
            return;
        } else {

            //	alert('should be showing a message');

            try {
                g_form.clearMessages();

				var cleanCount=data.count ? data.count:0;
                g_form.addInfoMessage('The caller ' + g_form.getDisplayValue('caller_id') + ' has (<br />' + cleanCount + ') active incidents. '  );
				

            } catch (err) {
                alert('error on the g_form message' + String(err));
            }
        }



    });







